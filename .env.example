# Copy this file to .env and fill in your real values.
# .env is gitignored — it will never be committed.
# Both values still end up inside the compiled app bundle (that's normal
# and expected for the Supabase anon key — see SUPABASE_SETUP.md for why
# that's safe). This file just keeps them out of git history.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
